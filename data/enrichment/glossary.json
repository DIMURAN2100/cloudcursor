      "theme": "governance",
      "dimension": "standards-frameworks"
    },
    {
      "term": "AI 红队",
      "en": "AI Red Teaming",
      "definition": "以对抗方式测试模型与 Agent 的安全性：从提示注入演练到「生成并验证可运行 PoC」的自动化产品形态；CREST 已推出配套服务认证。",
      "theme": "ai-defense",
      "dimension": "ai-vuln-hunting"
    },
    {
      "term": "零常设权限",
