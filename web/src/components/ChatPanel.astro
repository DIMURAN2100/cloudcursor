---
/**
 * 全站对话面板：针对某条简报要点提问。
 * 默认用构建期知识索引做本地检索回答；若配置 PUBLIC_CHAT_ENDPOINT 则走 LLM。
 */
// 默认走同源 /api/chat（由 astro dev 或 preview:chat 反代到 chat-proxy）
const chatEndpoint = import.meta.env.PUBLIC_CHAT_ENDPOINT || '/api/chat';
---

<div
  id="chat-panel"
  class="chat-panel"
  hidden
  data-endpoint={chatEndpoint}
  aria-live="polite"
>
  <div class="chat-panel__backdrop" data-chat-close></div>
  <aside class="chat-panel__sheet" id="chat-sheet" role="dialog" aria-labelledby="chat-panel-title">
    <div
      class="chat-panel__resizer"
      id="chat-resizer"
      role="separator"
      aria-orientation="vertical"
      aria-label="拖拽调整对话栏宽度"
      title="拖拽调整宽度"
    ></div>
    <header class="chat-panel__head">
      <div>
        <p class="chat-panel__eyebrow">智能对话</p>
        <h2 id="chat-panel-title">针对这条信息</h2>
      </div>
      <button type="button" class="chat-panel__close" data-chat-close aria-label="关闭">
        ×
      </button>
    </header>

    <div class="chat-panel__context" id="chat-context"></div>

    <div class="chat-panel__messages" id="chat-messages"></div>

    <form class="chat-panel__form" id="chat-form">
      <label class="visually-hidden" for="chat-input">提问</label>
      <textarea
        id="chat-input"
        name="q"
        rows="2"
        placeholder="例如：这对 SOC 意味着什么？该怎么落地检查？"
        required
      ></textarea>
      <div class="chat-panel__actions">
        <button type="submit" class="button">发送</button>
        <button type="button" class="button button--ghost" data-chat-suggest>
          推荐问题
        </button>
      </div>
    </form>
    <p class="chat-panel__hint" id="chat-hint">
      默认基于站内简报知识库回答并附原文链接；配置对话接口后可启用完整 LLM。
    </p>
  </aside>
</div>

<script>
  type Item = {
    id: string;
    title: string;
    summary: string;
    date?: string;
    type?: string;
    theme?: string;
    dimension?: string;
    sources?: { label: string; href: string }[];
  };

  type KnowledgeItem = Item & {
    briefingSlug?: string;
    tokens?: string[];
  };

  const panel = document.getElementById('chat-panel');
  const sheet = document.getElementById('chat-sheet') as HTMLElement | null;
  const resizer = document.getElementById('chat-resizer');
  const contextEl = document.getElementById('chat-context');
  const messagesEl = document.getElementById('chat-messages');
  const form = document.getElementById('chat-form') as HTMLFormElement | null;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement | null;
  const hint = document.getElementById('chat-hint');
  const endpoint = panel?.dataset.endpoint || '';
  const WIDTH_KEY = 'ai-simplify-chat-width';
  const MIN_W = 360;
  const MAX_W = () => Math.min(960, Math.floor(window.innerWidth * 0.92));

  let active: Item | null = null;
  let knowledge: KnowledgeItem[] = [];
  let knowledgeLoaded = false;

  function applyChatWidth(px: number) {
    if (!sheet) return;
    const w = Math.max(MIN_W, Math.min(MAX_W(), Math.round(px)));
    sheet.style.width = `${w}px`;
    try {
      localStorage.setItem(WIDTH_KEY, String(w));
    } catch {
      /* ignore */
    }
  }

  function restoreChatWidth() {
    try {
      const saved = Number(localStorage.getItem(WIDTH_KEY) || 520);
      if (saved) applyChatWidth(saved);
    } catch {
      applyChatWidth(520);
    }
  }

  restoreChatWidth();

  // 左侧拖拽调宽
  resizer?.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    const startX = e.clientX;
    const startW = sheet?.getBoundingClientRect().width || 520;
    const onMove = (ev: PointerEvent) => {
      // 侧栏贴右，向左拖 = 变宽
      applyChatWidth(startW + (startX - ev.clientX));
    };
    const onUp = () => {
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      document.body.classList.remove('is-resizing-chat');
    };
    document.body.classList.add('is-resizing-chat');
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
  });

  async function ensureKnowledge() {
    if (knowledgeLoaded) return;
    try {
      const res = await fetch('/knowledge.json');
      if (res.ok) {
        const data = await res.json();
        knowledge = data.items || [];
      }
    } catch {
      knowledge = [];
    }
    knowledgeLoaded = true;
  }

  function tokenize(text: string): string[] {
    return (text || '')
      .toLowerCase()
      .split(/[^a-z0-9\u4e00-\u9fff]+/i)
      .filter((t) => t.length >= 2);
  }

  function score(query: string, item: KnowledgeItem, boostId?: string): number {
    const q = tokenize(query);
    const blob = `${item.title} ${item.summary} ${item.type || ''} ${item.theme || ''}`;
    const tokens = item.tokens || tokenize(blob);
    let s = 0;
    for (const t of q) {
      if (tokens.includes(t)) s += 2;
      if ((item.title || '').toLowerCase().includes(t)) s += 3;
    }
    if (boostId && item.id === boostId) s += 8;
    if (active?.theme && item.theme === active.theme) s += 1;
    return s;
  }

  function related(query: string, limit = 4): KnowledgeItem[] {
    return knowledge
      .map((item) => ({ item, s: score(query, item, active?.id) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, limit)
      .map((x) => x.item);
  }

  function openPanel(item: Item) {
    active = item;
    panel?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    if (contextEl) {
      const sources =
        item.sources
          ?.map(
            (s) =>
              `<a href="${s.href}" target="_blank" rel="noopener noreferrer">${s.label}</a>`,
          )
          .join(' · ') || '暂无原文链接';
      contextEl.innerHTML = `
        <div class="tag">${item.type || '简报要点'}</div>
        <strong>${item.title}</strong>
        <p>${item.summary}</p>
        <p class="source-row"><span class="source-row__label">原文</span>${sources}</p>
      `;
    }
    if (messagesEl) {
      messagesEl.innerHTML = `
        <div class="chat-bubble chat-bubble--bot">
          已载入这条情报作为对话上下文。你可以问影响、怎么防、和哪些标准/法规相关。
        </div>`;
    }
    input?.focus();
  }

  function closePanel() {
    panel?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  function addBubble(role: 'user' | 'bot', html: string) {
    if (!messagesEl) return;
    const div = document.createElement('div');
    div.className = `chat-bubble chat-bubble--${role}`;
    div.innerHTML = html;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function localAnswer(question: string): string {
    const hits = related(`${active?.title || ''} ${question}`, 4);
    if (!hits.length && active) {
      const src =
        active.sources
          ?.map((s) => `<a href="${s.href}" target="_blank" rel="noopener">${s.label}</a>`)
          .join(' · ') || '无';
      return `
        <p>基于当前条目：<strong>${active.title}</strong></p>
        <p>${active.summary}</p>
        <p>原文：${src}</p>
        <p class="chat-note">未找到更多相关简报。可换个问法，或配置 PUBLIC_CHAT_ENDPOINT 启用完整模型对话。</p>
      `;
    }
    const parts = hits.map((h, i) => {
      const src =
        h.sources
          ?.slice(0, 2)
          .map((s) => `<a href="${s.href}" target="_blank" rel="noopener">${s.label}</a>`)
          .join(' · ') || '无原文';
      return `
        <p><strong>${i + 1}. ${h.title}</strong>${h.date ? ` · ${h.date}` : ''}</p>
        <p>${h.summary}</p>
        <p>原文：${src}</p>
      `;
    });
    return `
      <p>根据站内简报知识库，与「${question}」最相关的 ${hits.length} 条：</p>
      ${parts.join('<hr class="chat-hr" />')}
      <p class="chat-note">回答来自已收录简报，不编造站外事实。配置对话接口后可生成综合分析。</p>
    `;
  }

  async function llmAnswer(
    question: string,
  ): Promise<{ ok: true; html: string } | { ok: false; error: string }> {
    if (!endpoint || !active) {
      return { ok: false, error: '未配置对话接口' };
    }
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          question,
          context: active,
          related: related(`${active.title} ${question}`, 5),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        return {
          ok: false,
          error: data?.error || `对话接口返回 ${res.status}（请确认 chat-proxy 已启动）`,
        };
      }
      const html = data.answer || data.html;
      if (!html) return { ok: false, error: '对话接口返回空内容' };
      return { ok: true, html };
    } catch (err) {
      return {
        ok: false,
        error: `无法连接对话接口 ${endpoint}：${err?.message || err}`,
      };
    }
  }

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('[data-ask]') as HTMLElement | null;
    if (btn) {
      e.preventDefault();
      await ensureKnowledge();
      try {
        openPanel(JSON.parse(btn.getAttribute('data-ask') || '{}'));
      } catch {
        /* ignore */
      }
      return;
    }
    if (target.closest('[data-chat-close]')) {
      closePanel();
      return;
    }
    if (target.closest('[data-chat-suggest]') && active && input) {
      input.value = `结合「${active.title}」，说明对企业安全岗的影响，并给出 3 条本周可执行检查项。`;
      input.focus();
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = input?.value.trim();
    if (!q) return;
    addBubble('user', q);
    if (input) input.value = '';
    addBubble('bot', '正在调用模型…');
    await ensureKnowledge();
    const llm = await llmAnswer(q);
    const last = messagesEl?.querySelector('.chat-bubble--bot:last-child');
    if (llm.ok) {
      if (last) last.innerHTML = llm.html;
      if (hint) hint.textContent = '当前为 DeepSeek 模型回答（经 chat-proxy）。';
    } else {
      // 模型失败时展示原因，并附带站内检索兜底，避免静默退化让人误判
      const fallback = localAnswer(q);
      if (last) {
        last.innerHTML = `
          <p class="chat-note"><strong>模型未接通：</strong>${llm.error}</p>
          <hr class="chat-hr" />
          ${fallback}
        `;
      }
      if (hint) {
        hint.textContent =
          '模型调用失败，已回退站内检索。请确认 chat-proxy 在跑，并用 npm run preview:chat 或 npm run dev 打开网站。';
      }
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePanel();
  });
</script>
