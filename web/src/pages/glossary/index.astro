---
import { u } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadGlossary } from '../../lib/enrichment';
import { getTheme, themes } from '../../lib/taxonomy';

const terms = loadGlossary();

const groups = themes
  .map((t) => ({
    theme: t,
    items: terms.filter((term) => term.theme === t.slug),
  }))
  .filter((g) => g.items.length > 0);

const ungrouped = terms.filter((t) => !t.theme);

// 字母快速跳转
const letters = Array.from(
  new Set(
    terms
      .map((t) => (t.term[0] || '').toUpperCase())
      .filter((c) => /[A-Z0-9\u4e00-\u9fa5]/.test(c)),
  ),
).sort();
---

<BaseLayout title="术语墙" description="AI 安全高频术语：一句定义 + 关联主题维度。">
  <section class="page-hero">
    <div class="container">
      <h1>术语墙</h1>
      <p>
        每个术语一句话说清「是什么、为什么重要」，并链接到对应的研究维度。由每日智能加工持续补充。
      </p>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      {
        groups.length > 0 && (
          <nav class="glossary-tabs" aria-label="按主题筛选">
            {groups.map((g) => (
              <a href={`#theme-${g.theme.slug}`}>
                <span class="tag" data-theme={g.theme.slug}>{g.theme.name}</span>
                <span class="glossary-tabs__count">{g.items.length}</span>
              </a>
            ))}
            {ungrouped.length > 0 && (
              <a href="#theme-other"><span class="tag">其他</span><span class="glossary-tabs__count">{ungrouped.length}</span></a>
            )}
          </nav>
        )
      }

      {
        groups.map((g) => (
          <section id={`theme-${g.theme.slug}`} class="glossary-group">
            <header class="glossary-group__head">
              <span class="glossary-group__bar" data-theme={g.theme.slug}></span>
              <div>
                <h2>{g.theme.name}</h2>
                <p>{g.theme.summary}</p>
              </div>
            </header>
            <div class="glossary-list">
              {g.items.map((t) => {
                const dim = g.theme.dimensions.find((d) => d.slug === t.dimension);
                return (
                  <article class="glossary-item">
                    <h3>{t.term}</h3>
                    <p class="glossary-item__en">{t.en}</p>
                    <p class="glossary-item__def">{t.definition}</p>
                    {dim && (
                      <a class="glossary-item__link" href={u(`themes/${g.theme.slug}/#${dim.slug}`)}>
                        {dim.name} →
                      </a>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }

      {
        ungrouped.length > 0 && (
          <section id="theme-other" class="glossary-group">
            <header class="glossary-group__head">
              <span class="glossary-group__bar"></span>
              <div><h2>其他</h2><p>尚未挂接到具体主题的术语</p></div>
            </header>
            <div class="glossary-list">
              {ungrouped.map((t) => (
                <article class="glossary-item">
                  <h3>{t.term}</h3>
                  <p class="glossary-item__en">{t.en}</p>
                  <p class="glossary-item__def">{t.definition}</p>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {terms.length === 0 && <p class="section__desc">术语数据待每日加工生成。</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .glossary-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }
  .glossary-tabs a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem 0.35rem 0.4rem;
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .glossary-tabs a:hover { border-color: var(--signal); }
  .glossary-tabs__count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .glossary-group {
    margin-bottom: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }
  .glossary-group__head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }
  .glossary-group__bar {
    width: 4px;
    align-self: stretch;
    background: var(--signal);
    border-radius: 2px;
  }
  .glossary-group__bar[data-theme='ai-self']    { background: var(--accent-ai-self); }
  .glossary-group__bar[data-theme='ai-defense'] { background: var(--accent-ai-defense); }
  .glossary-group__bar[data-theme='infra-cve']  { background: var(--accent-infra); }
  .glossary-group__bar[data-theme='governance'] { background: var(--accent-gov); }
  .glossary-group h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
  }
  .glossary-group__head p {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .glossary-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .glossary-item {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    background: linear-gradient(150deg, rgba(12,143,104,0.05), rgba(15,31,26,0.02));
    display: grid;
    gap: 0.3rem;
  }
  .glossary-item h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .glossary-item__en {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .glossary-item__def {
    margin: 0.3rem 0 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .glossary-item__link {
    color: var(--signal);
    font-size: 0.78rem;
    text-decoration: none;
  }
</style>
