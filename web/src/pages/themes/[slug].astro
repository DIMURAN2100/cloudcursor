---
import { u } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HighlightItem from '../../components/HighlightItem.astro';
import { getTheme, themes, standards } from '../../lib/taxonomy';
import { collectDimensionHighlights, standardIntel } from '../../lib/briefings';
import { loadGlossary } from '../../lib/enrichment';

export function getStaticPaths() {
  return themes.map((theme) => ({ params: { slug: theme.slug } }));
}

const theme = getTheme(Astro.params.slug!);
if (!theme) {
  throw new Error('Theme not found');
}

const glossary = loadGlossary().filter((t) => t.theme === theme.slug);
const relatedStandards = standards.filter((s) =>
  theme.slug === 'governance'
    ? ['nist-rmf', 'iso-42001', 'owasp-llm', 'mitre-atlas', 'csa-maestro', 'crest-ai'].includes(s.slug)
    : theme.slug === 'ai-self'
      ? ['owasp-llm', 'mitre-atlas', 'csa-maestro'].includes(s.slug)
      : theme.slug === 'infra-cve'
        ? ['csa-maestro'].includes(s.slug)
        : ['crest-ai'].includes(s.slug),
);
---

<BaseLayout title={theme.name} description={theme.summary}>
  <section class="page-hero" data-theme={theme.slug}>
    <div class="container">
      <div class="meta-row">
        <a href={u("themes/")}>知识体系</a>
      </div>
      <h1>{theme.name}</h1>
      <p>{theme.summary}</p>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container theme-layout">
      <aside class="theme-aside">
        <div class="theme-aside__block">
          <p class="theme-aside__label">学习焦点</p>
          <p>{theme.focus}</p>
        </div>
        <nav class="theme-toc" aria-label="研究维度">
          {theme.dimensions.map((dim, i) => (
            <a href={`#${dim.slug}`}>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {dim.name}
            </a>
          ))}
        </nav>
      </aside>

      <div class="theme-main">
        {
          theme.dimensions.map((dim, idx) => {
            const items = collectDimensionHighlights(theme.slug, dim.slug, 8);
            return (
              <details
                id={dim.slug}
                class="dimension-block"
                open={idx === 0}
              >
                <summary>
                  <span class="dimension-block__head">
                    <span class="dimension-block__num">{String(idx + 1).padStart(2, '0')}</span>
                    <span>
                      <strong>{dim.name}</strong>
                      <em>{dim.question}</em>
                    </span>
                  </span>
                  <span class="dimension-block__count">{items.length} 条情报</span>
                </summary>
                <div class="dimension-block__body">
                  {items.length ? (
                    <ol class="highlight-list">
                      {items.map(({ briefing, highlight }) => (
                        <HighlightItem
                          title={highlight.title}
                          summary={highlight.summary}
                          type={highlight.type}
                          themeSlug={highlight.themeSlug}
                          date={briefing.date}
                          dateHref={u(`briefings/${briefing.slug}/`)}
                          sources={highlight.sources}
                        />
                      ))}
                    </ol>
                  ) : (
                    <p class="section__desc">该维度暂未匹配到简报要点，将随日更自动补充。</p>
                  )}
                </div>
              </details>
            );
          })
        }

        {(glossary.length > 0 || relatedStandards.length > 0) && (
          <div class="theme-related">
            {glossary.length > 0 && (
              <div class="theme-related__block">
                <h3>相关术语</h3>
                <ul>
                  {glossary.map((term) => (
                    <li>
                      <strong>{term.term}</strong>
                      <span>{term.en}</span>
                      <p>{term.definition}</p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {relatedStandards.length > 0 && (
              <div class="theme-related__block">
                <h3>相关标准</h3>
                <ul>
                  {relatedStandards.map((std) => (
                    <li>
                      <a href={u(`governance/#${std.slug}`)}>
                        <strong>{std.name}</strong>
                        <span>{std.org}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .theme-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .theme-aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 1.5rem;
  }
  .theme-aside__block {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .theme-aside__label {
    margin: 0 0 0.5rem;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }
  .theme-aside p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .theme-toc {
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
  }
  .theme-toc a {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .theme-toc a:last-child { border-bottom: 0; }
  .theme-toc a span {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .theme-toc a:hover { color: var(--ink); background: var(--signal-dim); }

  .theme-main {
    display: grid;
    gap: 0.85rem;
  }
  .dimension-block {
    border: 1px solid var(--line);
    background: rgba(14, 32, 26, 0.4);
  }
  .dimension-block > summary {
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 1.3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .dimension-block > summary::-webkit-details-marker { display: none; }
  .dimension-block[open] > summary {
    border-bottom: 1px solid var(--line);
  }
  .dimension-block__head {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
  }
  .dimension-block__num {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .dimension-block__head strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .dimension-block__head em {
    display: block;
    margin-top: 0.2rem;
    color: var(--muted);
    font-style: normal;
    font-size: 0.82rem;
  }
  .dimension-block__count {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    white-space: nowrap;
  }
  .dimension-block__body {
    padding: 0.3rem 1.3rem 1rem;
  }

  .theme-related {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line-strong);
  }
  .theme-related__block h3 {
    margin: 0 0 0.8rem;
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .theme-related__block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  .theme-related__block li {
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    background: rgba(14,32,26,0.4);
  }
  .theme-related__block strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.92rem;
  }
  .theme-related__block span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .theme-related__block p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .theme-related__block a {
    text-decoration: none;
    display: block;
  }
  .theme-related__block a:hover strong {
    color: var(--signal);
  }

  @media (max-width: 900px) {
    .theme-layout { grid-template-columns: 1fr; }
    .theme-aside { position: static; }
    .theme-related { grid-template-columns: 1fr; }
  }
</style>
