---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { companyCategories } from '../../lib/taxonomy';
import { companyMentionCount, matchHighlights } from '../../lib/briefings';
---

<BaseLayout
  title="产业图谱"
  description="全球 AI 安全相关公司与研究机构，按角色分类并挂接简报提及。"
>
  <section class="page-hero">
    <div class="container">
      <h1>产业图谱</h1>
      <p>
        谁在做 AI 安全、各自扮演什么角色。「提及」数来自全部简报要点的自动统计，点击日期可回看上下文。
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container" style="display:grid;gap:3rem">
      {
        companyCategories.map((cat) => (
          <div id={cat.slug}>
            <h2 class="section__title">{cat.name}</h2>
            <p class="section__desc">{cat.description}</p>
            <div class="company-grid">
              {cat.companies.map((company) => {
                const count = companyMentionCount(company.match);
                const recent = matchHighlights(company.match, 2);
                return (
                  <article class="company-card">
                    <header>
                      <h3>{company.name}</h3>
                      <span class="company-card__count">{count} 次提及</span>
                    </header>
                    <p>{company.note}</p>
                    {recent.length > 0 && (
                      <p class="company-card__recent">
                        最近：
                        {recent.map(({ briefing, highlight }, i) => (
                          <>
                            {i > 0 && ' · '}
                            <a href={`/briefings/${briefing.slug}/`} title={highlight.title}>
                              {briefing.date}
                            </a>
                          </>
                        ))}
                      </p>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        ))
      }

      <div class="panel">
        <h3>收录说明</h3>
        <p>
          图谱基于简报公开报道整理，不构成商业推荐；提及次数只反映在本站简报语料中的出现频率。随日更自动刷新。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
