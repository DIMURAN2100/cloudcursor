---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadBriefings } from '../../lib/briefings';

const briefings = loadBriefings();
const latest = briefings[0];
---

<BaseLayout title="今日简报台" description="全球 AI 安全日报归档与今日要点入口。">
  <section class="page-hero">
    <div class="container">
      <h1>今日简报台</h1>
      <p>日更要点服务安全运营节奏；完整正文可深读，历史日报永久归档。</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      {
        latest ? (
          <>
            <div class="meta-row">
              <span>最新：{latest.date}</span>
              <span>{latest.highlights.length} 条今日要点</span>
              <a href={`/briefings/${latest.slug}/`}>打开完整日报</a>
            </div>
            <ol class="highlight-list">
              {latest.highlights.map((h) => (
                <li>
                  <div class="highlight-list__meta">
                    <span class="tag">{h.type}</span>
                    <a href={`/themes/${h.themeSlug}/`}>{h.themeSlug}</a>
                  </div>
                  <h3>{h.title}</h3>
                  <p>{h.summary}</p>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <p>暂无简报数据。</p>
        )
      }

      <h2 class="section__title" style="margin-top:3rem">归档</h2>
      <p class="section__desc">按东八区日期归档；首页强调近七日，更早内容从这里检索。</p>
      <ul class="archive-list">
        {
          briefings.map((b) => (
            <li>
              <a href={`/briefings/${b.slug}/`}>
                <span>{b.date}</span>
                <strong>{b.highlights[0]?.title || b.title}</strong>
                <span style="color:var(--muted)">{b.highlights.length} 条要点</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
