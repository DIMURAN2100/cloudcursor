---
import { u } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import HighlightItem from '../components/HighlightItem.astro';
import ThreatSurfaceDiagram from '../components/ThreatSurfaceDiagram.astro';
import { brand } from '../lib/site';
import { regions, themes } from '../lib/taxonomy';
import {
  briefingsInLastDays,
  countMatches,
  countThemeHighlights,
  getLatestBriefing,
  loadBriefings,
} from '../lib/briefings';
import { loadDailyEnrichment } from '../lib/enrichment';

const all = loadBriefings();
const latest = getLatestBriefing(all);
const recent = briefingsInLastDays(7, all);
const highlights = latest?.highlights.slice(0, 5) ?? [];

const enrichment = latest ? loadDailyEnrichment(latest.date) : null;
const execBullets =
  enrichment?.execSummary.map((e) => ({
    title: e.title,
    text: e.insight,
    action: e.action,
    type: '决策要点',
  })) ??
  highlights.slice(0, 3).map((h) => ({
    title: h.title,
    text: h.summary.slice(0, 90) + (h.summary.length > 90 ? '…' : ''),
    action: '',
    type: h.type,
  }));
const headline = enrichment?.headline;

const topRegions = regions
  .map((r) => ({ region: r, count: countMatches(r.match) }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__field" aria-hidden="true"></div>
    <div class="hero__scan" aria-hidden="true"></div>
    <div class="container hero__content">
      <p class="hero__brand">{brand.name.replace('安全', '')}<em>安全</em></p>
      <h1 class="hero__title">{brand.tagline}</h1>
      <p class="hero__lede">
        面向企业安全岗与管理层：每日全球简报，沉淀为知识体系、治理地图与产业图谱。
      </p>
      <div class="cta-row">
        <a class="button" href={u("briefings/")}>看今日态势</a>
        <a class="button button--ghost" href={u("themes/")}>进入知识体系</a>
      </div>
    </div>
  </section>

  <section class="section" id="today">
    <div class="container">
      <p class="section__eyebrow">01 · Today</p>
      <h2 class="section__title">今日主线</h2>
      {
        latest ? (
          <>
            <p class="section__desc">
              <strong>{latest.date}</strong>
              {headline ? ` · ${headline}` : ` · ${latest.lede}`}
            </p>
            <div class="split">
              <div>
                <div class="panel" style="border-top:0;padding-top:0">
                  <h3>安全岗 · 可行动要点</h3>
                  <p>从今日简报提取可跟进的技术与流程动作；可点「针对这条对话」深入问。</p>
                </div>
                <ol class="highlight-list" style="margin-top:1.25rem">
                  {highlights.map((h) => (
                    <HighlightItem
                      title={h.title}
                      summary={h.summary}
                      type={h.type}
                      themeHref={u(`themes/${h.themeSlug}/#${h.dimensionSlug}`)}
                      sources={h.sources}
                      askPayload={{
                        id: `${latest.slug}#${h.index}`,
                        title: h.title,
                        summary: h.summary,
                        date: latest.date,
                        type: h.type,
                        theme: h.themeSlug,
                        dimension: h.dimensionSlug,
                        sources: h.sources,
                      }}
                    />
                  ))}
                </ol>
                <p style="margin-top:1.25rem">
                  <a class="button button--ghost" href={u(`briefings/${latest.slug}/`)}>
                    查看完整日报
                  </a>
                </p>
              </div>
              <aside class="panel" id="decision">
                <h3>管理层 · 决策摘要</h3>
                <p style="margin-bottom:1rem">本周应关注的风险主线与治理含义。</p>
                <ul class="highlight-list">
                  {execBullets.map((b) => (
                    <li>
                      <div class="highlight-list__meta">
                        <span class="tag">{b.type}</span>
                      </div>
                      <h3>{b.title}</h3>
                      <p>{b.text}</p>
                      {b.action && (
                        <p style="color:var(--warn)">
                          <strong>建议动作：</strong>
                          {b.action}
                        </p>
                      )}
                      <p class="ask-row">
                        <button
                          type="button"
                          class="ask-btn"
                          data-ask={JSON.stringify({
                            id: `exec-${b.title}`,
                            title: b.title,
                            summary: `${b.text}${b.action ? ` 建议动作：${b.action}` : ''}`,
                            type: '决策要点',
                            date: latest.date,
                            sources: [],
                          })}
                        >
                          针对这条对话
                        </button>
                      </p>
                    </li>
                  ))}
                </ul>
                <p style="margin-top:1.25rem">
                  <a href={u("governance/")}>看全球治理地图 →</a>
                </p>
              </aside>
            </div>
          </>
        ) : (
          <p class="section__desc">暂无简报。请先同步 `briefings/` 日报。</p>
        )
      }
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <p class="section__eyebrow">02 · Map</p>
      <h2 class="section__title">先建立威胁面地图</h2>
      <p class="section__desc">一张总图，避免把 AI 安全缩成单点提示词问题。</p>
      <ThreatSurfaceDiagram />
      <p style="margin-top:1rem">
        <a href={u("diagrams/")}>查看全部架构图 →</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <p class="section__eyebrow">03 · Learn</p>
      <h2 class="section__title">知识体系：四大主题 × 研究维度</h2>
      <p class="section__desc">
        每个主题按研究维度拆分：先知道该问什么问题，再用简报案例逐个看懂。
      </p>
      <div class="theme-grid">
        {
          themes.map((theme) => (
            <a class="theme-link" href={u(`themes/${theme.slug}/`)}>
              <h3>{theme.name}</h3>
              <p>{theme.summary}</p>
              <p style="margin-top:0.6rem;color:var(--signal);font-size:0.88rem">
                {theme.dimensions.map((d) => d.name).join(' / ')}
              </p>
              <p style="margin-top:0.4rem;color:var(--muted);font-size:0.85rem">
                {countThemeHighlights(theme.slug)} 条简报要点
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <p class="section__eyebrow">04 · Governance</p>
      <h2 class="section__title">全球治理与产业</h2>
      <p class="section__desc">政策法规按地区、公司机构按角色，都由简报持续供血。</p>
      <div class="split">
        <div class="panel">
          <h3>治理热区</h3>
          <ul class="highlight-list" style="margin-top:1rem">
            {
              topRegions.map(({ region, count }) => (
                <li>
                  <div class="highlight-list__meta">
                    <span class="tag">{region.flag}</span>
                    <span>{count} 条相关情报</span>
                  </div>
                  <h3>
                    <a href={u(`governance/#${region.slug}`)} style="text-decoration:none">
                      {region.name}
                    </a>
                  </h3>
                  <p>{region.stance}</p>
                </li>
              ))
            }
          </ul>
          <p style="margin-top:1rem">
            <a href={u("governance/")}>全部地区与标准框架 →</a>
          </p>
        </div>
        <div class="panel">
          <h3>产业图谱</h3>
          <p style="margin-bottom:1rem">
            模型厂商、AI 安全创业公司、传统安全巨头与研究机构：谁在做什么、最近被简报提到什么。
          </p>
          <p>
            <a class="button button--ghost" href={u("landscape/")}>
              打开产业图谱
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <p class="section__eyebrow">05 · Timeline</p>
      <h2 class="section__title">近七日情报推进</h2>
      <div class="timeline">
        {
          recent.map((b) => (
            <article class="timeline__item">
              <div class="timeline__date">{b.date}</div>
              <h3 class="timeline__title">
                <a href={u(`briefings/${b.slug}/`)}>{b.highlights[0]?.title || b.title}</a>
              </h3>
              <p class="timeline__meta">
                {b.highlights.length} 条要点 · {b.lede.slice(0, 80)}
                {b.lede.length > 80 ? '…' : ''}
              </p>
            </article>
          ))
        }
      </div>
      <p style="margin-top:1.5rem">
        <a class="button button--ghost" href={u("briefings/")}>进入简报归档</a>
      </p>
    </div>
  </section>
</BaseLayout>
