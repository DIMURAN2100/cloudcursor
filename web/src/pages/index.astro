---
import { u } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import HighlightItem from '../components/HighlightItem.astro';
import ThreatSurfaceDiagram from '../components/ThreatSurfaceDiagram.astro';
import { brand } from '../lib/site';
import { regions, themes } from '../lib/taxonomy';
import {
  briefingsInLastDays,
  countMatches,
  countThemeHighlights,
  getLatestBriefing,
  loadBriefings,
} from '../lib/briefings';
import { loadDailyEnrichment } from '../lib/enrichment';

const all = loadBriefings();
const latest = getLatestBriefing(all);
const recent = briefingsInLastDays(7, all);
const highlights = latest?.highlights.slice(0, 5) ?? [];
const totalHighlights = all.reduce((sum, briefing) => sum + briefing.highlights.length, 0);

const enrichment = latest ? loadDailyEnrichment(latest.date) : null;
const execBullets =
  enrichment?.execSummary.map((e) => ({
    title: e.title,
    text: e.insight,
    action: e.action,
    type: '决策要点',
  })) ??
  highlights.slice(0, 3).map((h) => ({
    title: h.title,
    text: h.summary.slice(0, 90) + (h.summary.length > 90 ? '…' : ''),
    action: '',
    type: h.type,
  }));
const headline = enrichment?.headline;

const topRegions = regions
  .map((r) => ({ region: r, count: countMatches(r.match) }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__field" aria-hidden="true"></div>
    <div class="hero__scan" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__copy">
        <p class="hero__kicker"><span></span> Global AI Security Observatory</p>
        <h1 class="hero__brand">AI 简化<em>安全</em></h1>
        <p class="hero__title">{brand.tagline}</p>
        <p class="hero__lede">
          面向企业安全岗与管理层，把分散的全球动态整理成可学习的知识体系、治理地图与行动线索。
        </p>
        <div class="cta-row">
          <a class="button" href={u("briefings/")}>阅读今日简报 <span>↗</span></a>
          <a class="text-link" href={u("themes/")}>浏览知识体系 <span>→</span></a>
        </div>
      </div>
      <aside class="hero-signal" aria-label="站点内容概览">
        <div class="hero-signal__head">
          <span>INTELLIGENCE STATUS</span>
          <span class="status-dot">持续更新</span>
        </div>
        <div class="hero-signal__focus">
          <span class="hero-signal__label">LATEST SIGNAL</span>
          <strong>{latest?.highlights[0]?.title || '等待最新简报'}</strong>
          <p>{headline || latest?.lede || '全球 AI 安全情报持续汇入。'}</p>
        </div>
        <div class="hero-signal__stats">
          <div><strong>{all.length}</strong><span>期简报</span></div>
          <div><strong>{totalHighlights}</strong><span>条情报</span></div>
          <div><strong>{themes.length}</strong><span>大主题</span></div>
        </div>
        <div class="hero-signal__foot">
          <span>LAST UPDATE</span>
          <time>{latest?.date || '—'}</time>
        </div>
      </aside>
      <div class="hero__index" aria-hidden="true">01</div>
    </div>
    <a class="hero__scroll" href="#today" aria-label="向下查看今日主线">
      <span></span>向下阅读
    </a>
  </section>

  <section class="ticker" aria-label="站点内容范围">
    <div class="container ticker__inner">
      <span class="ticker__label">TRACKING</span>
      <div class="ticker__items">
        <span>模型与智能体安全</span>
        <span>AI 防御与 SOC</span>
        <span>基础设施与供应链</span>
        <span>全球政策与标准</span>
      </div>
    </div>
  </section>

  <section class="section section--today" id="today">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section__eyebrow">01 / TODAY'S BRIEF</p>
          <h2 class="section__title">今日主线</h2>
        </div>
        <p class="section-head__note">从新闻事件进入知识结构，<br />从风险判断落到可执行动作。</p>
      </div>
      {
        latest ? (
          <>
            <div class="today-lead">
              <time>{latest.date}</time>
              <strong>{headline || latest.lede}</strong>
            </div>
            <div class="today-grid">
              <div class="today-feed">
                <div class="subsection-head">
                  <div><span>FOR SECURITY TEAMS</span><h3>安全岗 · 可行动要点</h3></div>
                  <span>{highlights.length.toString().padStart(2, '0')} SIGNALS</span>
                </div>
                <ol class="highlight-list highlight-list--numbered">
                  {highlights.map((h) => (
                    <HighlightItem
                      title={h.title}
                      summary={h.summary}
                      type={h.type}
                      themeHref={u(`themes/${h.themeSlug}/#${h.dimensionSlug}`)}
                      sources={h.sources}
                    />
                  ))}
                </ol>
                <p class="section-action">
                  <a class="text-link" href={u(`briefings/${latest.slug}/`)}>
                    查看完整日报 <span>→</span>
                  </a>
                </p>
              </div>
              <aside class="decision-panel" id="decision">
                <div class="subsection-head">
                  <div><span>FOR LEADERS</span><h3>管理层 · 决策摘要</h3></div>
                </div>
                <ol class="decision-list">
                  {execBullets.map((b, index) => (
                    <li>
                      <span class="decision-list__index">{String(index + 1).padStart(2, '0')}</span>
                      <h4>{b.title}</h4>
                      <p>{b.text}</p>
                      {b.action && (
                        <div class="action-callout"><span>建议动作</span>{b.action}</div>
                      )}
                    </li>
                  ))}
                </ol>
                <a class="decision-panel__link" href={u("governance/")}>查看全球治理地图 <span>↗</span></a>
              </aside>
            </div>
          </>
        ) : (
          <p class="section__desc">暂无简报。请先同步 `briefings/` 日报。</p>
        )
      }
    </div>
  </section>

  <section class="section section--map">
    <div class="container">
      <div class="map-layout">
        <div class="map-copy">
          <p class="section__eyebrow">02 / THREAT SURFACE</p>
          <h2 class="section__title">先看见全貌，<br />再判断风险。</h2>
          <p class="section__desc">AI 安全不只是提示注入。模型、数据、Agent、工具、基础设施与治理共同构成一张相互连接的攻击面。</p>
          <a class="text-link" href={u("diagrams/")}>查看全部架构图 <span>→</span></a>
        </div>
        <ThreatSurfaceDiagram />
      </div>
    </div>
  </section>

  <section class="section section--themes">
    <div class="container">
      <div class="section-head">
        <div><p class="section__eyebrow">03 / KNOWLEDGE SYSTEM</p><h2 class="section__title">四大主题，持续生长</h2></div>
        <p class="section-head__note">先理解问题框架，<br />再阅读每日案例。</p>
      </div>
      <div class="theme-grid">
        {
          themes.map((theme, index) => (
            <a class="theme-link" href={u(`themes/${theme.slug}/`)}>
              <div class="theme-link__top"><span>{String(index + 1).padStart(2, '0')}</span><span>{countThemeHighlights(theme.slug)} 条情报</span></div>
              <h3>{theme.name}<span>↗</span></h3>
              <p>{theme.summary}</p>
              <p class="theme-link__dimensions">
                {theme.dimensions.map((d) => d.name).join(' / ')}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--landscape">
    <div class="container">
      <div class="section-head">
        <div><p class="section__eyebrow">04 / GLOBAL LANDSCAPE</p><h2 class="section__title">治理、政策与产业</h2></div>
        <p class="section-head__note">在全球坐标中理解规则，<br />在产业变化中判断方向。</p>
      </div>
      <div class="landscape-grid">
        <div class="governance-board">
          <div class="subsection-head"><div><span>REGULATORY PULSE</span><h3>治理热区</h3></div></div>
          <ul class="region-list">
            {
              topRegions.map(({ region, count }, index) => (
                <li>
                  <span class="region-list__index">{String(index + 1).padStart(2, '0')}</span>
                  <a href={u(`governance/#${region.slug}`)}><strong>{region.name}</strong><span>{region.stance}</span></a>
                  <span class="region-list__count">{count}</span>
                </li>
              ))
            }
          </ul>
          <a class="text-link" href={u("governance/")}>全部地区与标准框架 <span>→</span></a>
        </div>
        <a class="industry-feature" href={u("landscape/")}>
          <span class="industry-feature__kicker">INDUSTRY MAP</span>
          <strong>谁在定义<br />AI 安全产业？</strong>
          <p>跟踪模型厂商、AI 安全创业公司、传统安全巨头与研究机构的角色变化。</p>
          <span class="industry-feature__arrow">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--timeline">
    <div class="container">
      <div class="section-head">
        <div><p class="section__eyebrow">05 / TIMELINE</p><h2 class="section__title">近七日情报推进</h2></div>
        <a class="text-link" href={u("briefings/")}>查看全部归档 <span>→</span></a>
      </div>
      <div class="timeline">
        {
          recent.map((b) => (
            <article class="timeline__item">
              <div class="timeline__date">{b.date}</div>
              <h3 class="timeline__title">
                <a href={u(`briefings/${b.slug}/`)}>{b.highlights[0]?.title || b.title}</a>
              </h3>
              <p class="timeline__meta">
                {b.highlights.length} 条要点 · {b.lede.slice(0, 80)}
                {b.lede.length > 80 ? '…' : ''}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
