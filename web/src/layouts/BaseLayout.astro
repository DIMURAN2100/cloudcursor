---
import '../styles/global.css';
import '../styles/components.css';
import '../styles/sections.css';
import '../styles/prose.css';
import { brand, nav } from '../lib/site';
import { u } from '../lib/urls';

const {
  title,
  description = brand.description,
  editorial = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${brand.name}` : `${brand.name} · ${brand.tagline}`;
const pathname = Astro.url.pathname;
const home = u();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Serif+SC:wght@500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{ 'is-editorial': editorial }]}>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={home} aria-label="AI简化安全首页">
          <span class="brand__mark" aria-hidden="true">A</span>
          <span class="brand__name">{brand.name.replace('安全', '')}<b>安全</b></span>
        </a>
        <nav class="nav" aria-label="主导航">
          {
            nav.map((item) => {
              const href = u(item.href);
              return (
                <a
                  href={href}
                  class:list={['nav__link', `nav__link--${item.group}`]}
                  aria-current={pathname.includes(item.href.replace(/\/$/, '')) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong class="footer-brand">{brand.name}</strong>
          <p>把全球 AI 安全情报，转化为可理解、可追踪、可执行的知识。</p>
        </div>
        <div class="footer-meta">
          <span>每日更新 · GMT+8</span>
          <a href={u('about/')}>方法与来源</a>
          <a href={u('rss.xml')} target="_blank" rel="noopener">RSS</a>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/timeline-observer.js';
      import '../scripts/diagram-hover.js';
    </script>
  </body>
</html>
